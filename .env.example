# JARVIS configuration template.
# Copy to ".env" and fill in ONE provider. Never commit the real .env file.
# You can also enter keys in the app's Settings > API tab; they are then
# encrypted with Windows DPAPI and stored in %APPDATA%\JARVIS\secrets.bin.

# Which provider to use: deepseek | openrouter | custom
JARVIS_PROVIDER=deepseek

# --- DeepSeek (https://platform.deepseek.com/api-keys) ---
DEEPSEEK_API_KEY=

# --- OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=

# --- Custom OpenAI-compatible endpoint (Ollama, LM Studio, vLLM, Azure, ...) ---
# Example: http://127.0.0.1:11434/v1
JARVIS_BASE_URL=
JARVIS_API_KEY=
JARVIS_MODEL=

# Optional: force a model regardless of provider default
JARVIS_MODEL_NAME=

# Optional: path to a Vosk speech model (defaults to the bundled/downloaded model)
JARVIS_VOSK_MODEL=

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
JARVIS_LOG_LEVEL=INFO